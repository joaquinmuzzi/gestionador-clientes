# Copiá este archivo a .env y completá los valores. Nunca commitees el .env.

# Base de datos (la usa docker-compose.yml para crear Postgres).
POSTGRES_USER=gestionador
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=gestionador

# Conexión desde la app corriendo con `npm run dev` (Postgres expuesto en localhost).
# Dentro de Docker Compose se arma sola apuntando al servicio "db".
DATABASE_URL=postgresql://gestionador:cambiar-esta-clave@localhost:5432/gestionador

# Clave maestra para cifrar secretos (AES-256-GCM). 32 bytes en base64.
# Generala con: openssl rand -base64 32
# Si se pierde, los secretos cifrados no se pueden recuperar: guardala aparte de los backups.
ENCRYPTION_KEY=
