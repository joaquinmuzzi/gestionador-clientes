# Copy this file to .env and fill in the values. Never commit the .env file.

# Database (docker-compose.yml uses these to create Postgres).
POSTGRES_USER=gestionador
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=gestionador

# Connection for the app running with `npm run dev` (Postgres exposed on localhost).
# Inside Docker Compose it is built automatically and points to the "db" service.
DATABASE_URL=postgresql://gestionador:change-this-password@localhost:5432/gestionador

# Master key that encrypts secrets (AES-256-GCM): 32 bytes in base64.
# Generate it with: openssl rand -base64 32
# If it is lost, the encrypted secrets cannot be recovered: keep it apart from the backups.
ENCRYPTION_KEY=

# Where the encrypted screenshots are stored. Empty: ./data/attachments (development).
# Docker Compose sets it to its own volume. Back it up together with the database.
ATTACHMENTS_DIR=

# --- Production server (docs/deployment.md) ---

# Public domain for HTTPS with Caddy (`docker compose --profile https up -d`). Leave it empty
# when the app is reached through Tailscale, which is the recommended setup.
SITE_ADDRESS=

# --- Backups (docs/backups.md) ---

# Password of the restic repositories: it encrypts every backup. Generate it with:
# openssl rand -base64 32. Keep it with ENCRYPTION_KEY, apart from the backups: without it the
# backups cannot be opened.
RESTIC_PASSWORD=

# Local copy: a directory on another disk or a NAS mounted on the server. Empty: ./backups.
BACKUP_LOCAL_DIR=

# Cloud copy, for example Backblaze B2 through its S3 endpoint:
# s3:https://s3.us-west-004.backblazeb2.com/my-bucket/gestionador
BACKUP_CLOUD_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Optional: a URL (healthchecks.io or similar) pinged after every backup, and with /fail when it
# fails, so a backup that stops running is noticed.
BACKUP_PING_URL=
