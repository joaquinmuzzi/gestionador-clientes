# HTTPS in front of the app for a public domain (docs/deployment.md). Caddy gets and renews the
# Let's Encrypt certificate on its own; SITE_ADDRESS comes from .env (for example
# gestionador.example.com) and its DNS record must point to this server.
{$SITE_ADDRESS} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}
