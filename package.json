{
  "name": "gestionador-clientes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/user.ts create",
    "user:reset-2fa": "tsx scripts/user.ts reset-2fa",
    "user:set-password": "tsx scripts/user.ts set-password",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/otp": "1.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@xyflow/react": "12.12.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
